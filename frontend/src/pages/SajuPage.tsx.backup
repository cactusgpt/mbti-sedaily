                  </div>

                  {/* 세부 점수 */}
                  <div className="grid grid-cols-2 gap-3 mb-4">
                    {Object.entries(day.stats).map(([key, value]) => (
                      <div key={key}>
                        <div className="text-[10px] tracking-wider uppercase text-gray-400">{key}</div>
                        <div
                          className="font-mono font-semibold"
                          style={{ color: value >= 60 ? '#16a34a' : value >= 40 ? '#d97706' : '#dc2626' }}
                        >
                          {value}
                        </div>
                      </div>
                    ))}
                  </div>

                  {/* 조언 */}
                  <div className="p-3 bg-amber-50/50 border border-amber-100 text-xs text-gray-600">
                    <div className="text-[10px] tracking-wider uppercase text-amber-600 mb-1">오늘의 조언</div>
                    {day.advice}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* 면책 조항 */}
        <div className="mt-12 p-5 border border-amber-200/50 text-center text-xs text-gray-500">
          <span className="text-amber-600">⚠</span> 이 대시보드는 투자 조언을 제공하지 않으며, 현재 상태의 시각화와 심리적 프레이밍을 통한 의사결정 지원을 목적으로 합니다.
        </div>
      </div>

      {/* 수정 모달 */}
      {showModal && (
        <div
          className="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4"
          onClick={(e) => e.target === e.currentTarget && setShowModal(false)}
        >
          <div
            ref={modalRef}
            className="bg-white w-full max-w-md p-8 shadow-xl"
          >
            <h3 className="text-xl font-bold text-amber-700 mb-8">프로필 수정</h3>

            <div className="space-y-6">
              <div>
                <label className="block text-[10px] tracking-[0.18em] uppercase text-gray-500 mb-2">생년월일</label>
                <input
                  type="date"
                  value={profile.birthDate}
                  onChange={(e) => setProfile(p => ({ ...p, birthDate: e.target.value }))}
                  className="w-full px-4 py-3 bg-amber-50/50 border border-amber-200 text-gray-800 font-mono focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-[10px] tracking-[0.18em] uppercase text-gray-500 mb-2">출생 시간</label>
                <input
                  type="time"
                  value={profile.birthTime}
                  onChange={(e) => setProfile(p => ({ ...p, birthTime: e.target.value }))}
                  className="w-full px-4 py-3 bg-amber-50/50 border border-amber-200 text-gray-800 font-mono focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-[10px] tracking-[0.18em] uppercase text-gray-500 mb-2">성별</label>
                <select
                  value={profile.gender}
                  onChange={(e) => setProfile(p => ({ ...p, gender: e.target.value }))}
                  className="w-full px-4 py-3 bg-amber-50/50 border border-amber-200 text-gray-800 focus:outline-none focus:border-amber-500"
                >
                  <option value="남성">남성</option>
                  <option value="여성">여성</option>
                </select>
              </div>
            </div>

            <div className="flex gap-3 mt-8">
              <button
                onClick={() => setShowModal(false)}
                className="flex-1 px-4 py-3 border border-gray-300 text-gray-600 text-xs tracking-wider uppercase hover:bg-gray-50 transition-colors"
              >
                취소
              </button>
              <button
                onClick={() => setShowModal(false)}
                className="flex-1 px-4 py-3 bg-amber-600 text-white text-xs tracking-wider uppercase hover:bg-amber-700 transition-colors"
              >
                저장
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
