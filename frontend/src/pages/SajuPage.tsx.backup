import { useState, useEffect, useRef } from "react";
import { Link } from "react-router-dom";
import { Home, Edit3, Star, TrendingUp, Calendar, Sparkles } from "lucide-react";

// 천간지지 데이터
const 천간 = ['갑','을','병','정','무','기','경','신','임','계'];
const 지지 = ['자','축','인','묘','진','사','오','미','신','유','술','해'];

const 오행천간: Record<string, string> = {
  '갑':'목','을':'목','병':'화','정':'화','무':'토','기':'토',
  '경':'금','신':'금','임':'수','계':'수'
};

const 오행지지: Record<string, string> = {
  '자':'수','축':'토','인':'목','묘':'목','진':'토','사':'화',
  '오':'화','미':'토','신':'금','유':'금','술':'토','해':'수'
};

const 오행 = { ...오행천간, ...오행지지 };

const 오행색상: Record<string, string> = {
  '목': '#22c55e',
  '화': '#ef4444',
  '토': '#eab308',
  '금': '#a855f7',
  '수': '#3b82f6'
};

const 육십갑자: string[] = [];
for (let i = 0; i < 60; i++) {
  육십갑자.push(천간[i % 10] + 지지[i % 12]);
}

// 절기 데이터
const 절기 = [
  {month:2, day:4, ji:'인'}, {month:3, day:6, ji:'묘'}, {month:4, day:5, ji:'진'},
  {month:5, day:6, ji:'사'}, {month:6, day:6, ji:'오'}, {month:7, day:7, ji:'미'},
  {month:8, day:8, ji:'신'}, {month:9, day:8, ji:'유'}, {month:10, day:8, ji:'술'},
  {month:11, day:7, ji:'해'}, {month:12, day:7, ji:'자'}, {month:1, day:6, ji:'축'}
];

function get월지지(date: Date): string {
  const y = date.getFullYear();
  for(let i=0; i<절기.length; i++){
    const s = 절기[i];
    const next = 절기[(i+1)%12];
    const start = new Date(y, s.month-1, s.day);
    const end = new Date(next.month === 1 ? y+1 : y, next.month-1, next.day);
    if(date >= start && date < end) return s.ji;
  }
  return '축';
}

function get년주(date: Date): string {
  const 입춘 = new Date(date.getFullYear(), 1, 4);
  let year = date.getFullYear();
  if(date < 입춘) year--;
  const index = (year - 4) % 60;
  return 육십갑자[(index+60)%60];
}

function get일주(date: Date): string {
  const base = new Date(1984, 1, 2);
  const diff = Math.floor((date.getTime() - base.getTime()) / 86400000);
  const index = (diff % 60 + 60) % 60;
  return 육십갑자[index];
}

function get월주(date: Date, 년천간: string): string {
  const 월지 = get월지지(date);
  const 년간Index = 천간.indexOf(년천간);
  const 월지Index = 지지.indexOf(월지);
  const 월간Index = (년간Index * 2 + 월지Index) % 10;
  return 천간[월간Index] + 월지;
}

function get시지지Index(hour: number): number {
  if (hour >= 23 || hour < 1) return 0;
  if (hour >= 1 && hour < 3) return 1;
  if (hour >= 3 && hour < 5) return 2;
  if (hour >= 5 && hour < 7) return 3;
  if (hour >= 7 && hour < 9) return 4;
  if (hour >= 9 && hour < 11) return 5;
  if (hour >= 11 && hour < 13) return 6;
  if (hour >= 13 && hour < 15) return 7;
  if (hour >= 15 && hour < 17) return 8;
  if (hour >= 17 && hour < 19) return 9;
  if (hour >= 19 && hour < 21) return 10;
  if (hour >= 21 && hour < 23) return 11;
  return 0;
}

function get시주(일천간: string, hour: number): string {
  const 지Index = get시지지Index(hour);
  const 일간Index = 천간.indexOf(일천간);
  const 시간Index = (일간Index * 2 + 지Index) % 10;
  return 천간[시간Index] + 지지[지Index];
}

interface 사주Result {
  년주: string;
  월주: string;
  일주: string;
  시주: string;
  일간: string;
}

function calculate사주(year: number, month: number, day: number, hour: number): 사주Result {
  const date = new Date(year, month-1, day);
  const 년주 = get년주(date);
  const 일주 = get일주(date);
  const 월주 = get월주(date, 년주[0]);
  const 시주 = get시주(일주[0], hour);

  return { 년주, 월주, 일주, 시주, 일간: 일주[0] };
}

// 오행 분석
function analyze오행(사주: 사주Result): Record<string, number> {
  const counts: Record<string, number> = { '목': 0, '화': 0, '토': 0, '금': 0, '수': 0 };
  const chars = 사주.년주 + 사주.월주 + 사주.일주 + 사주.시주;
  for (const char of chars) {
    if (오행[char]) {
      counts[오행[char]]++;
    }
  }
  return counts;
}

// 육친 점수 계산
function calculate육친점수(사주: 사주Result): Record<string, number> {
  // 간단한 시뮬레이션
  const 일간 = 사주.일간;
  const seed = 천간.indexOf(일간);
  return {
    관운: 30 + ((seed * 17) % 40),
    인성: 40 + ((seed * 23) % 35),
    식상: 50 + ((seed * 13) % 30),
    재성: 35 + ((seed * 19) % 45)
  };
}

// 주간 운세 계산
function calculate주간운세(사주: 사주Result): Array<{
  date: Date;
  dayGanzhi: string;
  total: number;
  grade: 'good' | 'mid' | 'bad';
  stats: { 관운: number; 재성: number; 인성: number; 식상: number };
  advice: string;
}> {
  const today = new Date();
  const result = [];

  for (let i = 0; i < 7; i++) {
    const date = new Date(today);
    date.setDate(date.getDate() + i);
    const dayGanzhi = get일주(date);

    // 점수 계산 (일간과 일주의 관계 기반)
    const 일간Index = 천간.indexOf(사주.일간);
    const 일주Index = 천간.indexOf(dayGanzhi[0]);
    const baseScore = 50 + ((일간Index + 일주Index + i * 7) % 40);

    const stats = {
      관운: 20 + ((일간Index * 17 + i * 11) % 60),
      재성: 25 + ((일간Index * 13 + i * 19) % 55),
      인성: 30 + ((일간Index * 23 + i * 7) % 50),
      식상: 35 + ((일간Index * 11 + i * 17) % 45)
    };

    const total = Math.round((baseScore + stats.관운 + stats.재성 + stats.인성 + stats.식상) / 5);

    const advices = [
      "새로운 기회에 열린 마음을 가지세요",
      "신중한 결정이 필요한 날입니다",
      "인간관계에서 좋은 소식이 있을 수 있어요",
      "재정적인 결정은 미루는 것이 좋겠어요",
      "창의적인 아이디어가 떠오르는 날",
      "건강에 신경 쓰는 하루가 되세요",
      "중요한 만남이 있을 수 있습니다"
    ];

    result.push({
      date,
      dayGanzhi,
      total,
      grade: (total >= 70 ? 'good' : total >= 45 ? 'mid' : 'bad') as 'good' | 'mid' | 'bad',
      stats,
      advice: advices[i]
    });
  }

  return result;
}

interface ProfileData {
  birthDate: string;
  birthTime: string;
  gender: string;
}

export default function SajuPage() {
  const [profile, setProfile] = useState<ProfileData>({
