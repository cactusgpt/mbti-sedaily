# API Configuration
NEXT_PUBLIC_API_URL=https://chzwwtjtgk.execute-api.us-east-1.amazonaws.com/dev

# Revalidation Secret (for on-demand ISR)
REVALIDATE_SECRET=your-secret-key-here

# Google AdSense Configuration
# Get your Publisher ID from: https://www.google.com/adsense > Account > Settings > Account Information
# Format: ca-pub-XXXXXXXXXXXXXXXXX (include the 'ca-' prefix)
# Example: NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXXX

# Google Analytics 4 (GA4) Configuration
# Get your Measurement ID from: https://analytics.google.com > Admin > Data Streams
# Format: G-XXXXXXXXXX
# Example: NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-ABC1234567
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
